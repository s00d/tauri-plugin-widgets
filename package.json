{
  "name": "tauri-plugin-widgets-api",
  "version": "0.6.2",
  "author": "s00d",
  "description": "Tauri v2 plugin for App Widgets on Android, iOS, macOS, Windows, and Linux from a shared JSON config.",
  "license": "MIT",
  "type": "module",
  "types": "./dist-js/index.d.ts",
  "main": "./dist-js/index.cjs",
  "module": "./dist-js/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s00d/tauri-plugin-widgets.git"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist-js/index.d.ts",
        "default": "./dist-js/index.js"
      },
      "require": {
        "types": "./dist-js/index.d.cts",
        "default": "./dist-js/index.cjs"
      }
    },
    "./render": {
      "import": {
        "types": "./dist-js/render.d.ts",
        "default": "./dist-js/render.js"
      },
      "require": {
        "types": "./dist-js/render.d.cts",
        "default": "./dist-js/render.cjs"
      }
    },
    "./schemas/*": "./schemas/*"
  },
  "bin": {
    "tauri-plugin-widgets-api": "./dist-cli/cli.mjs",
    "tauri-widgets": "./dist-cli/cli.mjs"
  },
  "files": [
    "dist-js",
    "dist-cli",
    "templates",
    "schemas/widget-config.v1.json",
    "schemas/plugin-config.v1.json",
    "schemas/capabilities.json",
    "swift/Package.swift",
    "swift/Sources",
    "widget.html",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rollup -c rollup.config.mjs",
    "build:widget": "WIDGET_ONLY=1 rollup -c rollup.config.mjs",
    "prepublishOnly": "pnpm build && publint --strict",
    "publint": "publint --strict",
    "pretest": "pnpm build",
    "test": "pnpm test:rust && pnpm test:cli && pnpm test:desktop && pnpm test:geometry && pnpm test:events && pnpm test:android && pnpm test:swift && pnpm docs:check",
    "test:rust": "cargo test --all-features",
    "typecheck:cli": "tsc -p src-cli/tsconfig.json --noEmit",
    "typecheck:widget": "tsc -p widget-src/tsconfig.json --noEmit",
    "typecheck": "pnpm typecheck:cli && pnpm typecheck:widget",
    "dev": "pnpm --dir examples/tauri-plugin-widgets-example run tauri dev",
    "build:example": "pnpm -C scripts cli build-example",
    "build:example:mobile": "pnpm -C scripts cli build-example ios android",
    "tauri-widgets": "node dist-cli/cli.mjs",
    "playground": "pnpm --dir examples/tauri-plugin-widgets-example run tauri dev",
    "codegen": "cargo run --bin gen-schema --features codegen && cargo run --bin gen-ts --features codegen && cargo run --bin gen-native --features codegen",
    "check:codegen": "pnpm codegen && git diff --exit-code schemas/widget-config.v1.json schemas/plugin-config.v1.json schemas/capabilities.json schemas/capabilities.coverage.json guest-js/generated/widget-types.ts swift/Sources/TauriWidgets/Generated/WireCatalog.swift android/src/main/java/render/WireTypes.kt docs/guide/_generated/capability-matrix.md",
    "cli:tools": "pnpm -C scripts cli",
    "tools": "node dist-cli/cli.mjs tools",
    "test:cli": "node --test tests/cli/*.test.mjs",
    "docs:generate": "pnpm tools docs-generate",
    "docs:check": "pnpm tools docs-generate --check",
    "docs:audit": "pnpm tools docs-audit",
    "docs:dev": "pnpm docs:generate && pnpm -C docs dev",
    "docs:build": "pnpm docs:generate && pnpm -C docs build",
    "docs:preview": "pnpm -C docs preview",
    "test:desktop": "playwright test -c tests/desktop/playwright.config.ts",
    "test:desktop:update": "UPDATE_SNAPSHOTS=1 GOLDEN_RECORD=1 GOLDEN_RECORD_ALL=1 playwright test -c tests/desktop/playwright.config.ts",
    "test:visual:desktop": "playwright test -c tests/desktop/playwright.config.ts tests/desktop/render.spec.ts",
    "test:events": "playwright test -c tests/desktop/playwright.config.ts tests/desktop/events.spec.ts",
    "test:events:update": "UPDATE_SNAPSHOTS=1 playwright test -c tests/desktop/playwright.config.ts tests/desktop/events.spec.ts",
    "test:geometry": "node tests/desktop/geometry-diff.mjs",
    "test:geometry:update": "pnpm test:desktop:update",
    "test:android": "bash scripts/sh/android-gradle.sh :testDebugUnitTest",
    "test:android:update": "bash scripts/sh/android-gradle.sh :testDebugUnitTest -PupdateSnapshots=true",
    "test:android:visual": "bash scripts/sh/android-gradle.sh :connectedDebugAndroidTest -Pandroid.testInstrumentationRunnerArguments.class=git.s00d.widgets.WidgetRenderTest",
    "shot:android": "bash scripts/sh/android-shot.sh",
    "shot:ios": "bash scripts/sh/ios-shot.sh",
    "shot:macos": "bash scripts/sh/macos-shot.sh",
    "test:swift": "cd swift && swift test --filter MacRenderTests && swift test --filter RenderTests && swift test --filter TransportTests && swift test --filter DispatcherCoverageTests",
    "test:ios:visual": "cd swift && swift test --filter RenderTests",
    "test:macos:visual": "cd swift && swift test --filter MacRenderTests",
    "test:macos:transports": "cargo test --lib transport:: && cargo test --test macos_transports && cd swift && swift test --filter TransportTests",
    "test:macos:pipeline": "bash tests/macos/pipeline.sh",
    "test:linux": "just test-linux-x11",
    "test:windows": "node tests/windows/compare.mjs",
    "triage": "pnpm tools triage",
    "audit:sheets": "pnpm tools audit-sheets",
    "hosts": "pnpm tools hosts",
    "shot": "pnpm tools shot",
    "cli:test": "pnpm tools test",
    "ios-up": "pnpm tools ios-up",
    "android-up": "pnpm tools android-up",
    "linux-up": "pnpm tools linux-up",
    "linux-up-wl": "pnpm tools linux-up-wl",
    "win-up": "pnpm tools win-up",
    "win-sync": "pnpm tools win-sync",
    "win-bootstrap": "pnpm tools win-bootstrap",
    "win-pack": "pnpm tools win-pack",
    "win-sideload": "pnpm tools win-sideload"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "citty": "^0.2.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^26.6.4",
    "publint": "^0.3.25",
    "rollup": "^4.64.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  }
}
