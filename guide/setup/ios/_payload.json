ed by ",[270,927,897],{}," (e.g. ",[270,930,931],{},"group.com.example.myapp",[342,933,934,935,938,939,942,943,946],{},"Enable ",[323,936,937],{},"App Groups"," on ",[323,940,941],{},"both"," App IDs (main + ",[270,944,945],{},"*.WidgetExtension",") and tick that group.",[296,948,949,950,466],{},"Full checklist and “id not available” notes: ",[917,951,953],{"href":952},"\u002Fguide\u002Ftransport#app-groups-signing-plugin-consumers","Apple data transport → App Groups & signing",[296,955,956,957,959],{},"In Xcode you only need a valid ",[323,958,357],{}," on both targets (Automatic signing). Capability UI is optional once entitlements + portal match.",[258,961,963,964,369],{"id":962},"step-6-plugin-config-tauriconfjson","Step 6: Plugin config (",[270,965,966],{},"tauri.conf.json",[296,968,969,971,972,971,975,978,979,982],{},[270,970,897],{}," ",[323,973,974],{},"writes",[270,976,977],{},"plugins.widgets"," with ",[270,980,981],{},"transport: \"appGroup\""," (required on iOS):",[263,984,988],{"className":985,"code":986,"language":987,"meta":268,"style":268},"language-json shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","{\n  \"plugins\": {\n    \"widgets\": {\n      \"appGroup\": \"group.\u003Cyour-tauri-identifier>\",\n      \"transport\": \"appGroup\"\n    }\n  }\n}\n","json",[270,989,990,994,1009,1023,1043,1060,1064,1069],{"__ignoreMap":268},[273,991,992],{"class":275,"line":276},[273,993,565],{"class":558},[273,995,996,999,1002,1004,1006],{"class":275,"line":525},[273,997,998],{"class":558},"  \"",[273,1000,1001],{"class":551},"plugins",[273,1003,743],{"class":558},[273,1005,559],{"class":558},[273,1007,1008],{"class":558}," {\n",[273,1010,1011,1014,1017,1019,1021],{"class":275,"line":533},[273,1012,1013],{"class":558},"    \"",[273,1015,1016],{"class":279},"widgets",[273,1018,743],{"class":558},[273,1020,559],{"class":558},[273,1022,1008],{"class":558},[273,1024,1025,1028,1031,1033,1035,1037,1039,1041],{"class":275,"line":541},[273,1026,1027],{"class":558},"      \"",[273,1029,1030],{"class":571},"appGroup",[273,1032,743],{"class":558},[273,1034,559],{"class":558},[273,1036,667],{"class":558},[273,1038,740],{"class":283},[273,1040,743],{"class":558},[273,1042,746],{"class":558},[273,1044,1045,1047,1050,1052,1054,1056,1058],{"class":275,"line":548},[273,1046,1027],{"class":558},[273,1048,1049],{"class":571},"transport",[273,1051,743],{"class":558},[273,1053,559],{"class":558},[273,1055,667],{"class":558},[273,1057,1030],{"class":283},[273,1059,673],{"class":558},[273,1061,1062],{"class":275,"line":568},[273,1063,617],{"class":558},[273,1065,1066],{"class":275,"line":578},[273,1067,1068],{"class":558},"  }\n",[273,1070,1071],{"class":275,"line":593},[273,1072,623],{"class":558},[296,1074,1075,1076,1079,1080,1083],{},"JS ",[270,1077,1078],{},"setWidgetConfig(..., group, widgetId)"," must use that same ",[270,1081,1082],{},"group"," string.",[296,1085,1086,1087,1090,1091,1094,1095,1098,1099,1102,1103,1105,1106,1109,1110,466],{},"Also keep Swift ",[270,1088,1089],{},"TauriWidgetProvider(..., widgetId:)"," aligned with the JS ",[270,1092,1093],{},"widgetId"," (CLI default is ",[270,1096,1097],{},"\"default\"","). If your app writes ",[270,1100,1101],{},"widgetId: \"weather\"",", pass ",[270,1104,1101],{}," into the provider or the extension reads ",[270,1107,1108],{},"config:default"," while the host wrote ",[270,1111,1112],{},"config:weather",[258,1114,1116],{"id":1115},"lock-screen-interactive-state-widget-push","Lock Screen, interactive state, widget push",[339,1118,1119,1150,1180,1197],{},[342,1120,1121,1124,1125,1127,1128,746,1131,1134,1135,1138,1139,1142,1143,1146,1147,451],{},[323,1122,1123],{},"Accessory families."," The ",[270,1126,897],{}," template also offers ",[270,1129,1130],{},"accessoryCircular",[270,1132,1133],{},"accessoryRectangular"," and ",[270,1136,1137],{},"accessoryInline",". They draw the config's ",[270,1140,1141],{},"accessory"," layout\n(else ",[270,1144,1145],{},"small","); the system tints it, so the widget background is dropped there and in\nthe tinted \u002F vibrant rendering modes (",[270,1148,1149],{},"widgetRenderingMode",[342,1151,1152,1155,1156,1159,1160,1163,1164,1167,1168,1171,1172,1175,1176,1179],{},[323,1153,1154],{},"Taps without the app."," A ",[270,1157,1158],{},"set"," on a button, toggle or link runs an AppIntent in the\nextension: it writes ",[270,1161,1162],{},"state:{widgetId}[#instance]"," in the App Group, reloads the\ntimeline and still queues ",[270,1165,1166],{},"action"," for the app. Toggles use ",[270,1169,1170],{},"Toggle(isOn:intent:)",", so\nthe switch flips at once. Do not add an ",[270,1173,1174],{},"AppIntentsPackage"," that lists\n",[270,1177,1178],{},"TauriWidgetsIntentsPackage"," to the extension (the template has none): the Swift\npackage links statically, its intents are already in the extension's metadata, and\nthat include makes the system drop all of them, so taps only open the app.",[342,1181,1182,1185,1186,1189,1190,1193,1194,1196],{},[323,1183,1184],{},"Widget push (iOS 26)."," Add ",[270,1187,1188],{},".pushHandler(TauriWidgetPushHandler.self)"," to the widget\nconfiguration and the Push Notifications capability; the token is in the App Group\n(",[270,1191,1192],{},"getWidgetPushToken",") for your server's APNs ",[270,1195,1016],{}," pushes.",[342,1198,1199,1202,1203,1206],{},[323,1200,1201],{},"Gallery preview."," The widget gallery shows the stored config (with the last fetched\n",[270,1204,1205],{},"source"," data), not a placeholder, once the app has written one.",[258,1208,1210],{"id":1209},"step-7-run","Step 7: Run",[263,1212,1214],{"className":265,"code":1213,"language":267,"meta":268,"style":268},"pnpm tauri ios dev\n",[270,1215,1216],{"__ignoreMap":268},[273,1217,1218,1220,1222,1224],{"class":275,"line":276},[273,1219,280],{"class":279},[273,1221,284],{"class":283},[273,1223,287],{"class":283},[273,1225,1226],{"class":283}," dev\n",[1228,1229],"hr",{},[258,1231,1233],{"id":1232},"when-it-fails","When it fails",[1235,1236,1238],"h3",{"id":1237},"widget-shows-no-configuration","Widget shows \"No configuration\"",[339,1240,1241,1255,1266,1273],{},[342,1242,1243,1244,1247,1248,1251,1252,1254],{},"Ensure the App Group identifier is ",[323,1245,1246],{},"identical"," in the main app, widget extension, ",[270,1249,1250],{},"plugins.widgets.appGroup",", and the JS ",[270,1253,1082],{}," argument.",[342,1256,1257,1258,1260,1261,1263,1264,451],{},"Ensure Swift ",[270,1259,1093],{}," matches JS ",[270,1262,1093],{}," (default ",[270,1265,1097],{},[342,1267,1268,1269,1272],{},"Call ",[270,1270,1271],{},"setWidgetConfig(...)"," from your app before adding the widget.",[342,1274,1275,1276,1278],{},"Confirm plugin init succeeded (missing ",[270,1277,1250],{}," aborts startup).",[1235,1280,1282],{"id":1281},"widget-doesnt-update","Widget doesn't update",[339,1284,1285,1288,1314,1320],{},[342,1286,1287],{},"Apple limits widget refreshes to ~40–70 per day.",[342,1289,1290,1291,1294,1295,1298,1299,1302,1303,1306,1307,1310,1311,466],{},"Check plugin throttle: ",[270,1292,1293],{},"TAURI_WIDGET_MIN_RELOAD_SECS"," (Debug default ",[270,1296,1297],{},"0",", Release default ",[270,1300,1301],{},"900","). Inspect ",[270,1304,1305],{},"ApplyOutcome.reload"," from ",[270,1308,1309],{},"setWidgetConfig"," — throttled reloads no longer look like success-only ",[270,1312,1313],{},"true",[342,1315,1316,1317,466],{},"For testing: in Xcode, use ",[323,1318,1319],{},"Debug → Simulate Timeline → After Refresh",[342,1321,1322,1323,1326],{},"For live counters, use ",[270,1324,1325],{},"{ type: \"timer\" }"," instead of frequent reloads.",[296,1328,1329,1330,1333,1334,466],{},"More symptoms: ",[917,1331,1332],{"href":40},"Troubleshooting index",". Transport: ",[917,1335,23],{"href":24},[1337,1338,1339],"style",{},"html pre.shiki code .sBMFI, html code.shiki .sBMFI{--shiki-light:#E2931D;--shiki-default:#FFCB6B;--shiki-dark:#FFCB6B}html pre.shiki code .sfazB, html code.shik