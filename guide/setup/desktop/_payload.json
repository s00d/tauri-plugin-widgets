ts after autostart",[258,1143,1144,1145,1148],{},"The same file keeps the set of open widget windows. ",[275,1146,1147],{},"closeWidgetWindow"," (and the renderer's close button) removes a window from it; quitting the app does not. Opt in to reopening them:",[410,1150,1154],{"className":1151,"code":1152,"language":1153,"meta":415,"style":415},"language-json shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","{ \"plugins\": { \"widgets\": { \"restoreWindowsOnStart\": true } } }\n","json",[275,1155,1156],{"__ignoreMap":415},[419,1157,1158,1161,1163,1167,1169,1171,1173,1175,1179,1181,1183,1185,1187,1190,1192,1194,1196,1198,1200],{"class":421,"line":422},[419,1159,1160],{"class":429},"{",[419,1162,449],{"class":429},[419,1164,1166],{"class":1165},"spNyl","plugins",[419,1168,456],{"class":429},[419,1170,491],{"class":429},[419,1172,430],{"class":429},[419,1174,449],{"class":429},[419,1176,1178],{"class":1177},"sBMFI","widgets",[419,1180,456],{"class":429},[419,1182,491],{"class":429},[419,1184,430],{"class":429},[419,1186,449],{"class":429},[419,1188,1189],{"class":512},"restoreWindowsOnStart",[419,1191,456],{"class":429},[419,1193,491],{"class":429},[419,1195,565],{"class":429},[419,1197,443],{"class":429},[419,1199,443],{"class":429},[419,1201,1202],{"class":429}," }\n",[258,1204,1205,1206,389],{},"From Rust: ",[275,1207,1208],{},"app.widget().restore_windows()",[310,1210,1212],{"id":1211},"live-activities-island-window-or-notification","Live activities: island, window or notification",[258,1214,1215,1216,1219,1220,1223,1224,1227,1228,1230,1231,1234,1235,389],{},"By default (",[275,1217,1218],{},"\"activitySurface\": \"island\"",") live activities appear as a black pill at the top centre of the primary display, like the iPhone Dynamic Island: around the camera notch on notched Macs, under the menu bar on other Macs, at the top edge on Windows and Linux. Hover (or click) expands it. The island window is labelled ",[275,1221,1222],{},"activity-_island",": allow it in your capability (",[275,1225,1226],{},"\"windows\": [\"main\", \"activity-*\"]","). For the rounded pill on macOS enable the plugin's ",[275,1229,689],{}," feature (",[275,1232,1233],{},"app.macOSPrivateApi: true","); without it the window is opaque black with square corners. See ",[290,1236,143],{"href":1237},"\u002Ffeatures\u002Flive-activities#desktop-island",[258,1239,1240,1243],{},[275,1241,1242],{},"\"activitySurface\": \"window\""," keeps the older small window in the top-right corner.",[258,1245,1246,1247,352,1250,1253,1254,1257],{},"With Cargo feature ",[275,1248,1249],{},"notify",[275,1251,1252],{},"\"activitySurface\": \"notification\""," shows live activities as system notifications: Linux via notify-rust (updates replace the same notification, progress as the ",[275,1255,1256],{},"value"," hint), Windows as a toast with an in-place progress bar. The same fallback is used when no activity window can open. macOS keeps the island.",[310,1259,1261],{"id":1260},"rust-data-sources","Rust data sources",[258,1263,1264,1265,1268,1269,381,1272,1275],{},"Feed ",[275,1266,1267],{},"{{data.…}}"," from the host without JavaScript (like eww ",[275,1270,1271],{},"defpoll",[275,1273,1274],{},"deflisten","):",[410,1277,1281],{"className":1278,"code":1279,"language":1280,"meta":415,"style":415},"language-rust shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","use tauri_plugin_widgets::WidgetExt;\nuse std::time::Duration;\n\napp.widget().register_poll_source(\"cpu\", Duration::from_secs(2), || {\n    serde_json::json!({ \"load\": read_load() })\n});\n\nlet (tx, rx) = std::sync::mpsc::channel();\napp.widget().register_listen_source(\"player\", rx); \u002F\u002F every tx.send(json) → setWidgetData\n","rust",[275,1282,1283,1299,1318,1322,1371,1402,1407,1411,1452],{"__ignoreMap":415},[419,1284,1285,1288,1291,1294,1297],{"class":421,"line":422},[419,1286,1287],{"class":512},"use",[419,1289,1290],{"class":1177}," taur