,"How it works",[289,290,291,302,311,354,397],"ol",{},[292,293,294,297,298,301],"li",{},[271,295,296],{},"setWidgetConfig"," writes IR into the desktop file store for ",[271,299,300],{},"(group, widgetId)",".",[292,303,304,306,307,310],{},[271,305,273],{}," opens a frameless Tauri webview on the ",[271,308,309],{},"widgetview"," protocol.",[292,312,313,314,317,318,321,322,325,326,329,330,333,334,337,338,341,342,341,345,348,349,353],{},"With Cargo feature ",[271,315,316],{},"linux"," (",[262,319,320],{},"default","), the window is built hidden and pinned ",[262,323,324],{},"before its first map"," — GDK hints for ",[271,327,328],{},"_NET_WM_WINDOW_TYPE_DESKTOP",", skip taskbar \u002F pager, sticky and below — then shown, and its position is applied again after the map (window managers often ignore it for DESKTOP windows). The default ",[271,331,332],{},"layer"," on Linux is ",[271,335,336],{},"desktop","; ",[271,339,340],{},"layer: \"top\""," \u002F ",[271,343,344],{},"\"bottom\"",[271,346,347],{},"\"normal\""," use ABOVE \u002F BELOW \u002F an ordinary window instead (",[267,350,352],{"href":351},"\u002Fguide\u002Fsetup\u002Fdesktop#window-modes","window modes",").",[292,355,356,357,360,361,317,363,365,366,369,370,373,374,377,378,341,381,384,385,388,389,392,393,396],{},"Optional feature ",[271,358,359],{},"layer-shell"," moves the webview into a gtk-layer-shell surface on Wayland: layer from ",[271,362,332],{},[271,364,336],{}," → Background, ",[271,367,368],{},"bottom"," → Bottom, ",[271,371,372],{},"top"," → Top; ",[271,375,376],{},"normal"," stays a plain toplevel), output from the monitor at the window position, namespace = window label, anchors + margins from ",[271,379,380],{},"x",[271,382,383],{},"y"," (or from ",[271,386,387],{},"placement",": right \u002F bottom anchors keep their offset when the output resizes). ",[271,390,391],{},"clickThrough"," empties the input region; ",[271,394,395],{},"focusable: false"," turns off keyboard interactivity.",[292,398,356,399,402,403,353],{},[271,400,401],{},"notify"," shows live activities as desktop notifications (",[271,404,405],{},"activitySurface: \"notification\"",[284,407,409],{"id":408},"setup","Setup",[289,411,412],{},[292,413,414],{},"Keep default features, or enable explicitly:",[416,417,422],"pre",{"className":418,"code":419,"language":420,"meta":421,"style":421},"language-toml shiki shiki-themes material-theme-lighter material-theme material-theme-palenight","tauri-plugin-widgets = { version = \"0.8\", features = [\"linux\"] }\n# Wayland:\n# tauri-plugin-widgets = { version = \"0.8\", features = [\"linux\", \"layer-shell\"] }\n","toml","",[271,423,424,478,485],{"__ignoreMap":421},[425,426,429,433,437,440,443,445,448,452,455,458,461,463,466,468,470,472,475],"span",{"class":427,"line":428},"line",1,[425,430,432],{"class":431},"sTEyZ","tauri-plugin-widgets ",[425,434,436],{"class":435},"sMK4o","=",[425,438,439],{"class":435}," {",[425,441,442],{"class":431}," version ",[425,444,436],{"class":435},[425,446,447],{"class":435}," \"",[425,449,451],{"class":450},"sfazB","0.8",[425,453,454],{"class":435},"\"",[425,456,457],{"class":435},",",[425,459,460],{"class":431}," features ",[425,462,436],{"class":435},[425,464,465],{"class":435}," [",[425,467,454],{"class":435},[425,469,316],{"class":450},[425,471,454],{"class":435},[425,473,474],{"class":435},"]",[425,476,477],{"class":435}," }\n",[425,479,481],{"class":427,"line":480},2,[425,482,484],{"class":483},"sHwdD","# Wayland:\n",[425,486,488],{"class":427,"line":487},3,[425,489,490],{"class":483},"# tauri-plugin-widgets = { version = \"0.8\", features = [\"linux\", \"layer-shell\"] }\n",[289,492,493,507],{"start":480},[292,494,495,496,499,500,503,504,301],{},"Allow the window label in capabilities (",[271,497,498],{},"windows"," + ",[271,501,502],{},"widgets:default",") — ",[267,505,11],{"href":506},"\u002Fguide\u002Finstall#permissions",[292,508,509,510,512,513,301],{},"Call ",[271,511,273],{}," as in ",[267,514,15],{"href":16},[258,516,517,518,301],{},"Contributor harness \u002F debugging: ",[267,519,520],{"href":237},"Linux harness",[284,522,524],{"id":523},"when-it-fails","When it fails",[526,527,528,538,544,554],"ul",{},[292,529,530,531,533,534,537],{},"Enable the ",[271,532,316],{}," feature for X11 DESKTOP pinning (",[271,535,536],{},"default-features = false"," drops it).",[292,539,540,541,543],{},"Wayland: try ",[271,542,359],{},"; plain X11 hints will not apply.",[292,545,546,547,550,551,301],{},"Window hidden behind everything and not clickable: that is ",[271,548,549],{},"layer: \"desktop\""," on some window managers; use ",[271,552,553],{},"layer: \"bottom\"",[292,555,556,557,559],{},"See ",[267,558,520],{"href":237}," for debugging pinned windows.",[258,561,562,563,301],{},"More symptoms: ",[267,564,565],{"href":40},"Troubleshooting index",[567,568,569],"style",{},"html pre.shiki code .sTEyZ, html code.shiki .sTEyZ{--shiki-light:#90A4AE;--shiki-default:#EEFFFF;--shiki-dark:#BABED8}html pre.shiki code .sMK4o, html code.shiki .sMK4o{--shiki-light:#39ADB5;--shiki-default:#89DDFF;--shiki-dark:#89DDFF}html pre.shiki code .sfazB, html code.shiki .sfazB{--shiki-light:#91B859;--shiki-default:#C3E88D;--shiki-dark:#C3E88D}html pre.shiki code .sHwdD, html code.shiki .sHwdD{--shiki-light:#90A4AE;--shiki-light-font-style:italic;--shiki-default:#546E7A;--shiki-default-font-style:italic;--shiki-dark:#676E95;--shiki-dark-font-style:italic}html .light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html.light .shiki span {color: var(--shiki-light);background: var(--shiki-light-bg);font-style: var(--shiki-light-font-style);font-weight: var(--shiki-light-font-weight);text-decoration: var(--shiki-light-text-decoration);}html .default .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .shiki span {color: var(--shiki-default);background: var(--shiki-default-bg);font-style: var(--shiki-default-font-style);font-weight: var(--shiki-default-font-weight);text-decoration: var(--shiki-default-text-decoration);}html .dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}html.dark .shiki span {color: var(--shiki-dark);background: var(--shiki-dark-bg);font-style: var(--shiki-dark-font-style);font-weight: var(--shiki-dark-font-weight);text-decoration: var(--shiki-dark-text-decoration);}",{"title":421,"searchDepth":480,"depth":487,"links":571},[572,573,574],{"id":286,"depth":480,"text":287},{"id":408,"depth":480,"text":409},{"id":523,"depth":480,"text":524},"Linux desktop widgets use the same embedded webview path as Desktop webview: createWidgetWindow without url (no widget.html copy). Extra Linux behavior is window pinning.","md",null,{},true,{"title":65,"description":575},"JAskivVQWK_2OJSDoGp3SqNd9w0xlFsOYNbsEsDJEGY",[583,585],{"title":61,"path":62,"stem":63,"description":584,"children":-1},"Two surfaces: Widgets Board (Adaptive Cards + MSIX provider) and\u002For the same desktop webview as other OSes.",{"title":69,"path":70,"stem":71,"description":586,"children":-1},"Desktop hosts show widgets as frameless transparent webview windows. The JSON config is drawn by a small HTML\u002FJS renderer shipped inside the Rust crate — you do not copy or install a separate widget.html for the default path.",1794660592554]