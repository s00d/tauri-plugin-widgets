<?xml version="1.0" encoding="utf-8"?>
<!-- Shown by the launcher until the first Glance composition arrives (initialLayout)
     (the picker preview is tauri_widget_preview). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tauri_widget_surface"
    android:padding="12dp">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/tauri_widget_loading"
        android:textColor="@color/tauri_widget_ink"
        android:textSize="14sp" />
</FrameLayout>
