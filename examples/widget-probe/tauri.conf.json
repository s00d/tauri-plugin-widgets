{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "widget-probe",
  "version": "0.1.0",
  "identifier": "com.s00d.widget-probe",
  "build": {
    "frontendDist": "."
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "widget-probe-main",
        "width": 1,
        "height": 1,
        "visible": false,
        "decorations": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
