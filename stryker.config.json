{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation testing of the TypeScript logic that has unit tests (vitest, tests/unit). Run: pnpm mutants:js. Report: reports/mutation/mutation.html. A surviving mutant means no test notices that change: fix the test.",
  "testRunner": "vitest",
  "mutate": [
    "widget-src/resolve.ts"
  ],
  "ignorePatterns": [
    "**",
    "!widget-src/**",
    "!tests/unit/**",
    "!tests/fixtures/resolve/**",
    "!vitest.config.ts",
    "!package.json",
    "!tsconfig.json"
  ],
  "disableTypeChecks": false,
  "reporters": [
    "clear-text",
    "progress",
    "html"
  ],
  "concurrency": 2,
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "tempDirName": ".stryker-tmp",
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ]
}
