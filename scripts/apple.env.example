# Template — copy to scripts/apple.env (gitignored) and fill in.
#   cp scripts/apple.env.example scripts/apple.env
#   set -a && source scripts/apple.env && set +a

export APPLE_DEVELOPMENT_TEAM=YOUR_TEAM_ID
export TAURI_WIDGETS_APP_GROUP=group.com.example.app
export TAURI_WIDGETS_BUNDLE_ID=com.example.app
export TAURI_WIDGETS_WIDGET_BUNDLE_ID=com.example.app.WidgetExtension

# ASC API key — for portal/automation only.
# Do NOT leave these set when running `pnpm tauri ios build` (dummy codesign).
export APPLE_API_KEY=
export APPLE_API_ISSUER=
export APPLE_API_KEY_PATH=

# export FASTLANE_USER=
# export FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD=

# Android: pin JDK ≤21 for AGP
# export JAVA_HOME=$(/usr/libexec/java_home -v 17)
# export ANDROID_HOME=$HOME/Library/Android/sdk
