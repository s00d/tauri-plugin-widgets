  "features": {
    "activity": {
      "android": {
        "note": "ongoing notification; Live Update chip on Android 16",
        "support": "full"
      },
      "desktop": {
        "note": "top-centre island pill (default) or corner window; no Lock Screen",
        "support": "degraded"
      },
      "ios": {
        "note": "Live Activity + Dynamic Island (iOS 16.2+)",
        "support": "full"
      },
      "macos": {
        "note": "island pill at the notch (default) or corner window; no Lock Screen",
        "support": "degraded"
      },
      "windows": {
        "note": "top-centre island pill (default) or corner window; no Lock Screen",
        "support": "degraded"
      }
    },
    "activity.island": {
      "android": {
        "note": "no island; the Live Update chip shows shortCriticalText",
        "support": "unsupported"
      },
      "desktop": {
        "note": "top-centre pill: X11 dock window, Wayland layer-shell overlay",
        "support": "full"
      },
      "ios": {
        "note": "Dynamic Island compact / minimal / expanded regions",
        "support": "full"
      },
      "macos": {
        "note": "pill around the notch, under the menu bar without one; hover expands",
        "support": "full"
      },
      "windows": {
        "note": "top-centre topmost pill, no taskbar button, no focus steal",
        "support": "full"
      }
    },
