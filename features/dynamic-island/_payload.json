[835,1231,1232,1235],{},[856,1233,1234],{},"Mac without a notch",[856,1236,1237],{},"floating pill just under the menu bar",[835,1239,1240,1243],{},[856,1241,1242],{},"Windows",[856,1244,1245],{},"top-centre topmost tool window, no taskbar button, does not take focus",[835,1247,1248,1251],{},[856,1249,1250],{},"Linux X11",[856,1252,1253],{},"top-centre DOCK window above other windows",[835,1255,1256,1259],{},[856,1257,1258],{},"Linux Wayland",[856,1260,1261,1262,1265],{},"with feature ",[288,1263,1264],{},"layer-shell",": an Overlay layer surface anchored to the top edge; without it an ordinary always-on-top window wherever the compositor puts it",[258,1267,1268],{},"The window is always exactly the visible shapes, so clicks next to the pill reach the\nwindows below. Hover is read from the global cursor position (a webview in an inactive\nmacOS app gets no mouse-enter events); where that is unavailable (Wayland), the page's own\nhover and a click expand it, and a click on the top band collapses it.",[276,1270,1272],{"id":1271},"setup","Setup",[1274,1275,1276,1294],"ul",{},[1277,1278,1279,1282,1283,1286,1287,864,1290,1293],"li",{},[267,1280,1281],{},"Desktop."," Allow the island window label in your capability (",[288,1284,1285],{},"\"windows\": [\"main\", \"activity-*\"]",").\nOn macOS enable the plugin feature ",[288,1288,1289],{},"macos-private-api",[288,1291,1292],{},"app.macOSPrivateApi: true"," for the\ntransparent, rounded pill.",[1277,1295,1296,1299,1300,1303,1304,815,1307,1310,1311,1314,1315,425],{},[267,1297,1298],{},"iOS."," Add ",[288,1301,1302],{},"TauriLiveActivity()"," to the extension's ",[288,1305,1306],{},"WidgetBundle",[288,1308,1309],{},"NSSupportsLiveActivities = YES"," to the app's Info.plist (",[288,1312,1313],{},"init-ios"," does both); see\n",[262,1316,143],{"href":1317},"\u002Ffeatures\u002Flive-activities#setup",[258,1319,1320],{},"The whole request stays under 4 KiB of JSON (the ActivityKit limit), checked on every platform.",[1322,1323,13