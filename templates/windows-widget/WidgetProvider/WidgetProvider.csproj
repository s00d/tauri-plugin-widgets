<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TauriWidgets.WidgetProvider</RootNamespace>
    <AssemblyName>{{PACKAGE_NAME}}.WidgetProvider</AssemblyName>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <!-- MSIX tooling = WinAppSDK's own MSBuild tasks (tools/net6.0 in the NuGet), so
         `dotnet build` works; without it the PRI / payload targets load Visual Studio's
         AppxPackage tasks (MSB4062). Unpackaged all the same (WindowsPackageType None),
         as the WinUI templates do. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- No XAML / resources: nothing to put in a resources.pri. -->
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <!-- Smoke=true: compile Store + provider stubs without WinAppSDK Appx/PRI tools -->
    <Smoke Condition="'$(Smoke)' == ''">false</Smoke>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Smoke)' == 'true'">
    <TargetFramework>net8.0-windows</TargetFramework>
    <TargetPlatformMinVersion>7.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <DefineConstants>$(DefineConstants);WIDGET_SMOKE</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(Smoke)' != 'true'">
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250108002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
  </ItemGroup>
</Project>
