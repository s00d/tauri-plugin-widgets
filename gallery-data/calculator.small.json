{
  "$schema": "https://s00d.github.io/tauri-plugin-widgets/schemas/widget-config.v1.json",
  "version": 1,
  "small": {
    "type": "vstack",
    "padding": 6,
    "spacing": 2,
    "cornerRadius": 14,
    "background": "#1c1c1e",
    "children": [
      {
        "type": "hstack",
        "spacing": 4,
        "alignment": "center",
        "children": [
