          {
            "type": "spacer"
          },
          {
            "type": "text",
            "content": "0",
            "fontSize": 20,
            "fontWeight": "bold",
            "color": "#ffffff",
            "alignment": "trailing",
            "lineLimit": 1
          }
        ]
      },
      {
        "type": "divider",
        "color": "#3a3a3c",
        "thickness": 1
      },
