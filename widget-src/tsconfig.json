{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noImplicitAny": true,
    "declaration": false,
    "rootDir": ".",
    "outDir": ".",
    "noEmit": true
  },
  "include": ["./**/*.ts", "./**/*.d.ts"],
  "exclude": [".bundle.js", "node_modules"]
}
